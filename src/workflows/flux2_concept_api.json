{
  "100": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (FLUX.2-dev fp8mixed)" },
    "inputs": {
      "unet_name": "flux2_dev_fp8mixed.safetensors",
      "weight_dtype": "default"
    }
  },
  "101": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP (Mistral-3-Small FLUX.2)" },
    "inputs": {
      "clip_name": "mistral_3_small_flux2_bf16.safetensors",
      "type": "flux2"
    }
  },
  "102": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE (flux2-vae)" },
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "103": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" },
    "inputs": {
      "clip": ["101", 0],
      "text": "__PROMPT__"
    }
  },
  "104": {
    "class_type": "FluxGuidance",
    "_meta": { "title": "Flux Guidance" },
    "inputs": {
      "conditioning": ["103", 0],
      "guidance": 4.0
    }
  },
  "105": {
    "class_type": "BasicGuider",
    "_meta": { "title": "Basic Guider" },
    "inputs": {
      "model": ["100", 0],
      "conditioning": ["104", 0]
    }
  },
  "106": {
    "class_type": "KSamplerSelect",
    "_meta": { "title": "Sampler: euler" },
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "107": {
    "class_type": "Flux2Scheduler",
    "_meta": { "title": "Flux2 Scheduler" },
    "inputs": {
      "steps": 20,
      "width": 1024,
      "height": 1024
    }
  },
  "108": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": { "title": "Empty Latent 1024x1024" },
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "109": {
    "class_type": "RandomNoise",
    "_meta": { "title": "Random Noise (base_seed=88400)" },
    "inputs": {
      "noise_seed": 88400
    }
  },
  "110": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "Sampler Custom Advanced" },
    "inputs": {
      "noise": ["109", 0],
      "guider": ["105", 0],
      "sampler": ["106", 0],
      "sigmas": ["107", 0],
      "latent_image": ["108", 0]
    }
  },
  "111": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": {
      "samples": ["110", 0],
      "vae": ["102", 0]
    }
  },
  "112": {
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" },
    "inputs": {
      "images": ["111", 0],
      "filename_prefix": "__PREFIX__"
    }
  }
}
